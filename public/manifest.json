{
  "manifest_version": 3,
  "name": "TubeDeck",
  "version": "0.1.0",
  "description": "Understand the video, explore its discussion, and keep the moments that matter. Bring your own Gemini key.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage", "scripting", "identity", "clipboardWrite"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*"
  ],
  "optional_host_permissions": ["https://*.googlevideo.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "TubeDeck settings",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "options_page": "settings.html",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.html", "panel.js", "panel.css"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://generativelanguage.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://*.googlevideo.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-src 'none'"
  }
}
