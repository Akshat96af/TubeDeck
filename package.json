{
  "name": "tubedeck",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/preview.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:secrets",
    "package": "npm run verify && node scripts/package.mjs",
    "format": "prettier --write src tests scripts public/manifest.json package.json tsconfig.json vitest.config.ts README.md PRIVACY.md docs"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "lucide-react": "^0.577.0",
    "marked": "^17.0.0",
    "mediabunny": "^1.61.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/chrome": "^0.1.37",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
